{
  "name": "earwise",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "author": "earwise",
  "description": "Demand intelligence — find what people are asking for, and the buyers asking for it.",
  "build": {
    "appId": "com.earwise.app",
    "productName": "earwise",
    "asar": false,
    "directories": { "output": "dist" },
    "files": ["electron/**", "build/scanner.mjs", "build/dashboard.html", "package.json", "!node_modules/**", "!**/*.md", "!**/*.map"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "dashboard": "tsx scripts/dashboard.ts",
    "scan": "tsx scripts/scan-standalone.ts",
    "build:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "app": "electron .",
    "icon": "node scripts/gen-icon.mjs",
    "collect": "tsx scripts/collector.ts",
    "collect:once": "tsx scripts/collector.ts --once"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postject": "^1.0.0-alpha.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
